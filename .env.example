# --- Config data (server-only; never exposed to the browser) -----------------
# Single Supabase project hosting every service schema (wbgts, noise-meters,
# haze, lightning, ailytics) plus ops.config_audit.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Auth (dedicated Supabase Auth project, as in the other Wenti portals) ---
NEXT_PUBLIC_AUTH_SUPABASE_URL=
NEXT_PUBLIC_AUTH_SUPABASE_PUBLISHABLE_KEY=

# At least one must be set in production, or nobody gets in (fails closed).
WHITELIST_EMAILS=
WHITELIST_DOMAINS=

# Who may CHANGE configs. Empty = everyone who can sign in may edit.
EDITOR_EMAILS=

# `next dev` on a loopback hostname bypasses auth unless explicitly disabled.
# Ignored in production and on non-loopback hostnames.
LOCAL_AUTH_BYPASS=true
