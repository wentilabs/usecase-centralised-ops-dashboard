# --- Config data (server-only; never exposed to the browser) -----------------
# Single Supabase project hosting every service schema (wbgts, noise-meters,
# haze, lightning, ailytics) plus ops.config_audit.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- WhatsApp listener (read-only, for group id → group name on the cards) ---
# Separate Supabase project holding whatsapp_listener. Optional: without it the
# cards simply show raw group ids.
LISTENER_SUPABASE_URL=
LISTENER_SUPABASE_ANON_KEY=

# --- Viso / wa-mirror (optional) ----------------------------------------------
# Base URL of the WhatsApp mirror. When set, each group chip on a card links to
# VISO_URL/go/<chatId>, which resolves the chat's company there and redirects.
# Deliberately server-side (no NEXT_PUBLIC_ prefix) so it can change without a
# rebuild. Unset simply means the chips are not links.
VISO_URL=

# --- Alert-service APIs (optional; needed for the sheet-job buttons) ----------
# Base URL of each deployed service Lambda / API Gateway stage, WITHOUT a
# trailing path. HALO appends the endpoint itself, e.g.
#   NOISE_API_URL + /api/noise-sheet-bootstrap
#   NOISE_API_URL + /api/noise-sheet-sync
#   WBGT_API_URL  + /api/wbgt-sheet-fill
# Server-side by design, so the URLs never reach the browser and the buttons are
# gated on HALO's own editor permission. Unset simply hides nothing — the button
# is shown and reports which variable is missing.
NOISE_API_URL=
WBGT_API_URL=

# --- Auth (dedicated Supabase Auth project, as in the other Wenti portals) ---
NEXT_PUBLIC_AUTH_SUPABASE_URL=
NEXT_PUBLIC_AUTH_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key. The shared auth project enforces CAPTCHA, so
# sign-in is rejected without this in any non-loopback deployment. The matching
# secret is configured in the Supabase auth project itself.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# At least one must be set in production, or nobody gets in (fails closed).
WHITELIST_EMAILS=
WHITELIST_DOMAINS=

# Who may CHANGE configs. Empty = everyone who can sign in may edit.
EDITOR_EMAILS=

# `next dev` on a loopback hostname bypasses auth unless explicitly disabled.
# Ignored in production and on non-loopback hostnames.
LOCAL_AUTH_BYPASS=true
