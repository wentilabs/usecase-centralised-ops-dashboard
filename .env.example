# =============================================================================
# Single Supabase project hosting every centralised service's schema
# (wbgts, noise-meters, haze, lightning, ailytics) plus ops.config_audit.
# Copy the values from any alerts repo's .env — they point at the same project.
# =============================================================================
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Auth (required in production; leave blank for local loopback use) -------
# Dedicated Supabase Auth project, matching the other Wenti front-ends.
# The URL may be an activated custom domain.
AUTH_SUPABASE_URL=
AUTH_SUPABASE_PUBLISHABLE_KEY=

# Who may sign in. At least one must be set in production or nobody gets in
# (the dashboard fails closed by design).
WHITELIST_EMAILS=
WHITELIST_DOMAINS=

# Who may CHANGE configs. Empty = everyone who can sign in may edit.
# Set this to make everyone else read-only.
EDITOR_EMAILS=

# On a loopback hostname in non-production, auth is bypassed unless this is
# "false". Ignored entirely when NODE_ENV=production or the host isn't loopback.
LOCAL_AUTH_BYPASS=true

# --- Server ------------------------------------------------------------------
# 127.0.0.1 keeps the app private to the box (cloudflared publishes it).
# Only use 0.0.0.0 when something else terminates access control in front.
# HOST=127.0.0.1
# PORT=5178

# Where links.store.json and the audit mirror are kept. Point this outside the
# checkout when deployed, e.g. /var/lib/centralised-services.
# STATE_DIR=

# Schema overrides (defaults match the alert repos)
# WBGT_SCHEMA=wbgts
# NOISE_SCHEMA=noise-meters
# HAZE_SCHEMA=haze
# LIGHTNING_SCHEMA=lightning
# AILYTICS_SCHEMA=ailytics
