{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo.internal/contracts/service-contract.schema.json",
  "title": "Centralised service contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "service", "runtime", "routes", "configuration"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "displayName"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handler", "language", "moduleFormat"],
      "properties": {
        "handler": { "type": "string", "minLength": 1 },
        "language": { "enum": ["javascript", "typescript"] },
        "moduleFormat": { "enum": ["commonjs", "esm"] }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path", "kind", "authentication"],
        "properties": {
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string", "pattern": "^/" },
          "kind": { "enum": ["scheduled", "operator", "webhook", "read", "diagnostic"] },
          "authentication": { "enum": ["none", "optional-service-key", "required-service-key", "lambda-auth", "sms-hmac", "required-hmac"] }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "table", "identityColumn", "fields", "constraints"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "identityColumn": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "help"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "help": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "group", "mutable", "role", "help"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "mutable": { "type": "boolean" },
        "role": { "enum": ["identity", "configuration", "feature-flag", "policy-selector", "renderer-selector", "runtime-state"] },
        "help": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
